  {
    "name": "batch",
    "description": "Atomic batch up to 200 steps, millimeters. Actions: level, wall, floor, ceiling, room, grid, material, view3d, plan, beam, column, component, hosted_component, pipe, duct, conduit, cable_tray, opening, text, detail_line, viewport. Use typeId, levelId, systemTypeId, hostId, viewId or sheetId as appropriate; point/start/end are XYZ objects (z required for advanced actions). Optional alias on each step; subsequent ID fields may reference earlier aliases as $name. Also supports foundation, terrain (XYZ points), section, roof, model_line and tag. Also grid dimensions, schedule fields, type duplication, MEP elbow/union fittings; firstId and secondId accept earlier aliases. Also wall top constraints, geometry joins, room tags, schedule placement, area plans, area boundary lines and areas. Also view template, detail level, section box, duplicate view, visibility, group and perspective camera. Also mirror copy, sized pipes/ducts, transition and tee fittings. thirdId can reference a prior alias. Also railings, shafts, wall orientation and sized electrical containment.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expectedPath": {
          "type": "string"
        },
        "commit": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "level",
                  "wall",
                  "floor",
                  "ceiling",
                  "room",
                  "grid",
                  "material",
                  "view3d",
                  "plan",
                  "beam",
                  "column",
                  "component",
                  "hosted_component",
                  "pipe",
                  "duct",
                  "conduit",
                  "cable_tray",
                  "opening",
                  "text",
                  "detail_line",
                  "viewport",
                  "foundation",
                  "terrain",
                  "section",
                  "roof",
                  "model_line",
                  "tag",
                  "dimension",
                  "schedule_field",
                  "duplicate_type",
                  "elbow",
                  "union",
                  "wall_top_constraint",
                  "join_geometry",
                  "unjoin_geometry",
                  "room_tag",
                  "schedule_on_sheet",
                  "area_plan",
                  "area_boundary",
                  "area",
                  "apply_view_template",
                  "set_view_detail_level",
                  "set_section_box",
                  "duplicate_view",
                  "hide_elements",
                  "unhide_elements",
                  "group_elements",
                  "perspective",
                  "mirror_copy",
                  "pipe_sized",
                  "duct_sized",
                  "transition",
                  "tee",
                  "railing",
                  "shaft_opening",
                  "wall_flip",
                  "conduit_sized",
                  "cable_tray_sized"
                ]
              }
            }
          }
        }
      },
      "required": [
        "expectedPath",
        "steps"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
