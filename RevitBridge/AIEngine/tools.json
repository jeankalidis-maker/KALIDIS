  {
    "name": "batch",
    "description": "Atomic batch up to 200 steps, millimeters. Actions: level, wall, floor, ceiling, room, grid, material, view3d, plan, beam, column, component, hosted_component, pipe, duct, conduit, cable_tray, opening, text, detail_line, viewport. Use typeId, levelId, systemTypeId, hostId, viewId or sheetId as appropriate; point/start/end are XYZ objects (z required for advanced actions).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expectedPath": {
          "type": "string"
        },
        "commit": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "level",
                  "wall",
                  "floor",
                  "ceiling",
                  "room",
                  "grid",
                  "material",
                  "view3d",
                  "plan",
                  "beam",
                  "column",
                  "component",
                  "hosted_component",
                  "pipe",
                  "duct",
                  "conduit",
                  "cable_tray",
                  "opening",
                  "text",
                  "detail_line",
                  "viewport"
                ]
              }
            }
          }
        }
      },
      "required": [
        "expectedPath",
        "steps"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
